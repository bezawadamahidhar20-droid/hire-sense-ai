# Copy this file to `.env` and fill in your values before running the app.
# The app will refuse to start without DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: extra origins allowed to call Server Actions (the login 400
# fix). Comma-separated hostnames, no protocol, keep ports. Wildcards match
# subdomains only. Localhost is allowed by default.
# ALLOWED_ORIGINS=app.example.com,*.preview.example.com